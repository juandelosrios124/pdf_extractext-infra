# Configuracion de la infraestructura compartida (Consul + Traefik + red mired).
#   cp .env.example .env
# Los nombres marcados como COMPARTIDA se usan igual en extract-service y
# documents-service: no renombrarlas.

# --- COMPARTIDA: red externa donde viven Consul, extract y documents ---
# Crearla una sola vez:  docker network create mired
SHARED_NETWORK=mired

# --- Tokens de ACL de Consul (default_policy deny; ver "ACL" en el README) ---
# Todos obligatorios, con formato UUID y distintos entre si. Generarlos con
# uuidgen (en fish, los cuatro de servicio de una vez):
#   for v in AGENT TRAEFIK EXTRACT DOCUMENTS; echo "CONSUL_"$v"_TOKEN="(uuidgen); end
# Nunca commitearlos: .env esta en .gitignore. consul-acl-init los crea en
# Consul con ese SecretID en cada "docker compose up".

# --- solo infra: token de management (initial_management) ---
# Acceso total. Lo usan solo consul-acl-init, la CLI dentro del contenedor de
# consul y los smoke tests de infra. NO copiarlo a extract ni a documents.
CONSUL_HTTP_TOKEN=

# --- solo infra: token del agente de Consul (policy agent) ---
# node:write sobre el nodo "ds" y service:read, para mantener su nodo en el
# catalogo.
CONSUL_AGENT_TOKEN=

# --- solo infra: token de Traefik (policy traefik) ---
# Solo lectura de servicios y nodos para el provider Consul Catalog.
CONSUL_TRAEFIK_TOKEN=

# --- token de extract-service (policy extract) ---
# service:write solo sobre "extract". Va como CONSUL_HTTP_TOKEN en el .env de
# extract-service.
CONSUL_EXTRACT_TOKEN=

# --- token de documents-service (policy documents) ---
# service:write solo sobre "documents". Va como CONSUL_HTTP_TOKEN en el .env de
# documents-service.
CONSUL_DOCUMENTS_TOKEN=

# --- COMPARTIDA (solo extract/documents): URL de Consul desde la red mired ---
# Infra no la usa; se documenta aca para que los servicios usen el mismo valor.
# CONSUL_HTTP_ADDR=http://consul:8500

# --- COMPARTIDA (solo extract/documents): activar registro y discovery ---
# CONSUL_ENABLED=false

# --- solo infra: puerto del host para la UI/API (siempre en 127.0.0.1) ---
CONSUL_UI_PORT=8500

# --- solo infra: puerto del host para el trafico de Traefik (127.0.0.1) ---
# Entrypoint "web": por aca entran los pedidos a extract y documents.
TRAEFIK_PORT=8080

# --- solo infra: puerto del host para dashboard, API, ping y metricas ---
# Entrypoint interno "traefik" (siempre en 127.0.0.1).
TRAEFIK_DASHBOARD_PORT=8081

# --- solo infra: timeouts del entrypoint "web" de Traefik ---
# Fuente de verdad: "Presupuesto de timeouts" en el README. Cambiar primero
# la tabla y despues estos valores. Formato de duracion de Go (30s, 1m30s).
# Lectura del request completo (headers + body). Igual al timeout del cliente.
TRAEFIK_READ_TIMEOUT=30s
# Desde el fin de los headers hasta el fin de la respuesta: cubre la subida del
# body (hasta READ) + la espera a extract (responseHeaderTimeout 25s) + la
# escritura. Con menos de 55s puede cortar el 504 de Traefik sin enviarlo.
TRAEFIK_WRITE_TIMEOUT=60s
# Conexion keep-alive ociosa (cliente -> Traefik) antes de cerrarla.
TRAEFIK_IDLE_TIMEOUT=90s

# --- solo infra: limites de recursos del contenedor de Traefik ---
TRAEFIK_CPUS=0.5
TRAEFIK_MEMORY=256M
