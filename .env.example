# Configuracion de la infraestructura compartida (Consul + red mired).
#   cp .env.example .env
# Los nombres marcados como COMPARTIDA se usan igual en extract-service y
# documents-service: no renombrarlas.

# --- COMPARTIDA: red externa donde viven Consul, extract y documents ---
# Crearla una sola vez:  docker network create mired
SHARED_NETWORK=mired

# --- COMPARTIDA: token de ACL de Consul (initial_management) ---
# Obligatorio y con formato UUID. Generarlo con:  uuidgen
# Nunca commitearlo: .env esta en .gitignore. Los tres repos usan el mismo valor.
CONSUL_HTTP_TOKEN=

# --- COMPARTIDA (solo extract/documents): URL de Consul desde la red mired ---
# Infra no la usa; se documenta aca para que los servicios usen el mismo valor.
# CONSUL_HTTP_ADDR=http://consul:8500

# --- COMPARTIDA (solo extract/documents): activar registro y discovery ---
# CONSUL_ENABLED=false

# --- solo infra: puerto del host para la UI/API (siempre en 127.0.0.1) ---
CONSUL_UI_PORT=8500
